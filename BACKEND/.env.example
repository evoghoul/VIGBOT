# Environment configuration for VIGBOT Backend

# Database
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/vigbot
USE_IN_MEMORY_DB=true

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# AI Model Provider
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o

PRIVACY_POLICY_MESSAGE="I cannot share other student records under university policies"
