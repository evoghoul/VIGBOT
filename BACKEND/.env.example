# Environment configuration for VIGBOT Backend

# Application & Environment
APP_NAME="VIGBOT API"
ENVIRONMENT=development

# Database Configuration (Default: SQLite database/vigbot.db)
DATABASE_URL=sqlite:///database/vigbot.db
USE_IN_MEMORY_DB=false

# Security & JWT Secrets
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Providers Configuration
# Google Gemini (Primary Cloud LLM, disabled by default)
ENABLE_GEMINI=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Groq Cloud (Fallback Cloud LLM, disabled by default)
ENABLE_GROQ=false
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ML Intent Classifier (Zero-latency CPU classifier)
USE_INTENT_CLASSIFIER=true
ALLOW_PIPELINE_TEST_MODEL=false
INTENT_MODEL_PATH=artifacts/intent_model.joblib
INTENT_CONFIG_PATH=artifacts/intent_config.json

# CORS Allowed Origins (Comma-separated or JSON list)
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
