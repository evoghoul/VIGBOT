{
  "output": {
    "filePath": "tools/vibe-simplifier/output/vigbot-packed.md",
    "style": "markdown",
    "headerText": "VIGBOT Codebase Context - Packed for AI Simplification & Refactoring",
    "instructionFilePath": "tools/vibe-simplifier/INSTRUCTIONS.md",
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "showLineNumbers": true
  },
  "include": [
    "BACKEND/app/**/*.py",
    "FRONTEND/src/**/*.{ts,tsx}"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/database/*.db*",
      "**/.user_uploaded/**",
      "**/archive/**",
      "**/FRONTEND/src/data/students-db.ts",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/.git/**"
    ]
  }
}
