{
  "output": {
    "filePath": "tools/vibe-simplifier/output/backend-packed.md",
    "style": "markdown",
    "headerText": "VIGBOT Backend Python Context - Packed for Refactoring & Simplification",
    "instructionFilePath": "tools/vibe-simplifier/INSTRUCTIONS.md",
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "showLineNumbers": true
  },
  "include": [
    "BACKEND/app/**/*.py",
    "BACKEND/tests/**/*.py"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.venv/**",
      "**/__pycache__/**",
      "**/.pytest_cache/**",
      "**/database/*.db*",
      "**/.git/**"
    ]
  }
}
