{
  "output": {
    "filePath": "tools/vibe-simplifier/output/frontend-packed.md",
    "style": "markdown",
    "headerText": "VIGBOT Frontend TypeScript Context - Packed for Refactoring & Simplification",
    "instructionFilePath": "tools/vibe-simplifier/INSTRUCTIONS.md",
    "removeComments": false,
    "removeEmptyLines": true,
    "topFilesLength": 10,
    "showLineNumbers": true
  },
  "include": [
    "FRONTEND/src/**/*.{ts,tsx}"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/node_modules/**",
      "**/.next/**",
      "**/FRONTEND/src/data/students-db.ts",
      "**/package-lock.json",
      "**/pnpm-lock.yaml",
      "**/.git/**"
    ]
  }
}
